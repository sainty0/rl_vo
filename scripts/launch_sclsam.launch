<launch>
  <arg name="project" default="rl_launcher"/>
  <!-- NEW: enable/disable exporter & set output file -->
  <arg name="enable_metrics_exporter" default="true"/>
  <arg name="metrics_out_file" default="/tmp/rlvo/probe.json"/>

  <!-- Parameters -->
  <rosparam file="$(find lio_sam)/config/params_mulran.yaml" command="load" />

  <!--- LOAM -->
  <include file="$(find lio_sam)/launch/include/module_loam.launch" />

  <!--- Robot State TF -->
  <include file="$(find lio_sam)/launch/include/module_robot_state_publisher.launch" />

  <!--- Run Navsat -->
  <include file="$(find lio_sam)/launch/include/module_navsat.launch" />

  <!--- Run Rviz-->
  <include file="$(find lio_sam)/launch/include/module_rviz.launch" />

  <!-- Rosbridge server (WebSocket on 9090 by default) -->
  <node pkg="rosbridge_server" type="rosbridge_websocket.py" name="rosbridge_websocket" output="screen">
    <param name="port" value="9090"/>
    <param name="unregister_timeout" value="10.0"/>
  </node>

  <!-- Metrics Exporter (only if enabled) -->
  <group if="$(arg enable_metrics_exporter)">
    <node pkg="metric_pkg" type="metrics_exporter.py" name="rl_metrics_exporter" output="screen">
      <param name="out_file" value="$(arg metrics_out_file)"/>
      <param name="dropout_thresh" value="0.3"/>
      <param name="scan_topic"   value="/lio_sam/deskew/cloud_deskewed"/>
      <param name="surf_topic"   value="/lio_sam/feature/cloud_surface"/>
      <param name="corner_topic" value="/lio_sam/feature/cloud_corner"/>
      <param name="odom_topic"   value="/lio_sam/mapping/odometry_incremental"/>
      <param name="imu_topic"    value="/imu/data_raw"/>
      <param name="max_tokens" value="64"/>
      <param name="match_tol_s" value="0.05"/>
    </node>
  </group>
</launch>
